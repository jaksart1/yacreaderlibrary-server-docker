FROM ghcr.io/linuxserver/baseimage-ubuntu:arm64v8-resolute

# package versions
ARG YACR_VERSION="10.1.0"

# env variables
ARG DEBIAN_FRONTEND="noninteractive"
ENV APPNAME="YACReaderLibraryServer"
ENV HOME="/config"
LABEL maintainer="xthursdayx"

# install build & runtime packages
RUN \
    apt-get update && \
    apt-get install -y --no-install-recommends \
       build-essential \
       cmake \
       gcc \
       g++ \
       git \
       make \
       pkg-config \
       qt6-base-dev \
       qt6-base-dev-tools \
       qt6-declarative-dev \
       qt6-multimedia-dev \
       qt6-svg-dev \
       qt6-5compat-dev \
       qt6-shadertools-dev \
       qt6-tools-dev \
       qt6-tools-dev-tools \
       qt6-image-formats-plugins \
       libqt6opengl6-dev \
       libqt6sql6-sqlite \
       libgl-dev \
       libglu1-mesa-dev \
       libbz2-dev \
       liblzma-dev \
       libsqlite3-dev \
       zlib1g-dev \
       sqlite3 \
       p7zip-full \
       unzip \
       wget && \
# build yacreaderlibraryserver
# YACReader 10.x switched from qmake to CMake and requires Qt >= 6.4 for the
# standalone server (Qt 6.7+ for the full GUI build). See the project INSTALL.md.
# The 7zip decompression backend now downloads and compiles its own 7-Zip
# source via CMake FetchContent, so no external 7z SDK/binaries are required.
    git clone --depth 1 --branch $YACR_VERSION --single-branch \
       https://github.com/YACReader/yacreader.git /src/git && \
    cd /src/git && \
    cmake -B build -S . \
       -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_INSTALL_PREFIX=/app \
       -DBUILD_SERVER_STANDALONE=ON \
       -DDECOMPRESSION_BACKEND=7zip \
       -DPDF_BACKEND=no_pdf \
       -DBUILD_TESTS=OFF && \
    cmake --build build --parallel && \
    cmake --install build && \
# clean up
    cd / && \
    apt-get clean && \
    apt-get purge -y build-essential cmake gcc g++ git make pkg-config unzip wget && \
    apt-get -y autoremove && \
    rm -rf \
       /src \
       /tmp/* \
       /var/cache/apt \
       /var/lib/apt/lists/*

# set ENV
ENV LC_ALL="en_US.UTF-8" \
    PATH="/app/bin:${PATH}"

# copy files
COPY root/ /

# ports and volumes
EXPOSE 8080
VOLUME ["/config", "/comics"]
